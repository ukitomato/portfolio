        "gh-pages": "^3.2.3",
        "prettier": "^2.3.2",
        "react-test-renderer": "^17.0.2",
        "typescript": "^4.3.5"
    },
    "jest": {
        "coveragePathIgnorePatterns": [
            "src/index.tsx",
            "reportWebVitals.ts",
