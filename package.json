    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@babel/core": "^7.15.0",
        "@testing-library/jest-dom": "^5.14.1",
        "@testing-library/react": "^12.0.0",
        "@testing-library/user-event": "^13.2.1",
        "@types/jest": "^27.0.1",
        "@types/node": "^16.6.1",
        "@types/react": "^17.0.17",
